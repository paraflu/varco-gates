# Porta interna (NPM proxy → 3099)
PORT=3000

# Admin UI password (OBLIGATORIA)
ADMIN_PASSWORD=change-me-strong-password

# Segreto HMAC per cookie sessione (OBLIGATORIO, 64 hex random)
# Genera con: openssl rand -hex 32
COOKIE_SECRET=generate-with-openssl-rand-hex-32

# Home Assistant REST API
HA_BASE_URL=http://192.168.3.27:8123
HA_TOKEN=xxxxxxxxxxxxx

# Entity override (defaults already set in compose)
# GATE_ANDREA_ENTITY=switch.sonoff_1002658c25_1
# GATE_ALESSANDRO_ENTITY=switch.sonoff_1002592ef9_1

